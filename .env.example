# Chronicum — environment template
# Lite (default): SQLite + in-process durable queue with startup recovery, no Docker/Postgres/Redis.

TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_OWNER_ID=0
GROQ_API_KEY=replace_me

CHRONICUM_LITE=true
DATABASE_URL=sqlite+aiosqlite:///./data/chronicum.db
REDIS_URL=redis://127.0.0.1:6379/0
STORAGE_PATH=./data/files

# Optional: browser cookies for Instagram / TikTok when rate-limited (Netscape cookies.txt or browser name):
# MEDIA_COOKIES_FILE=./data/media_cookies.txt
# MEDIA_COOKIES_FROM_BROWSER=chrome
# Optional: custom path to tesseract binary for local OCR:
# TESSERACT_CMD=tesseract

# Full mode (Postgres + Redis + ARQ):
# CHRONICUM_LITE=false
# DATABASE_URL=postgresql+asyncpg://chronicum:chronicum@127.0.0.1:5432/chronicum
# REDIS_URL=redis://127.0.0.1:6379/0

# AI & transcription
AI_PROVIDER=groq
TRANSCRIBE_PROVIDER=groq
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3
# Whisper language: "auto" (detect) or ISO code like "ru" / "en"
WHISPER_LANGUAGE=auto
# Chunk audio automatically before uploading to Groq Whisper (Groq free tier limit is 25 MB)
WHISPER_MAX_FILE_MB=20.0
WHISPER_CHUNK_SECONDS=600
# Try YouTube subtitles / auto-captions before downloading media & spending Whisper quota
YOUTUBE_PREFER_CAPTIONS=true
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.0-flash

# Video & queue tuning
VIDEO_PREVIEW_THRESHOLD_MIN=10
VIDEO_FULL_SCORE_THRESHOLD=6
VIDEO_PREVIEW_FRACTION=0.2
VIDEO_CONCURRENCY=1
ARQ_MAX_JOBS=2
MAX_API_RETRIES=3
LOG_LEVEL=INFO

# Web API & frontend (change WEB_API_TOKEN / NEXT_PUBLIC_WEB_API_TOKEN before exposing beyond localhost!)
WEB_API_TOKEN=chronicum-dev-token
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WEB_API_TOKEN=chronicum-dev-token
# Set to false outside local dev so placeholder secrets fail fast on startup
ALLOW_PLACEHOLDER_SECRETS=true

# Standalone stdio MCP server (optional; defaults to API at http://127.0.0.1:8000 and WEB_API_TOKEN)
# CHRONICUM_API_URL=http://127.0.0.1:8000
# CHRONICUM_TOKEN=chronicum-dev-token
