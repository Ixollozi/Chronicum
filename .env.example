# Chronicum — environment template
# Lite (default): SQLite + in-process queue, no Docker/Postgres/Redis.

TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_OWNER_ID=0
GROQ_API_KEY=replace_me

CHRONICUM_LITE=true
DATABASE_URL=sqlite+aiosqlite:///./data/chronicum.db
REDIS_URL=redis://127.0.0.1:6379/0
STORAGE_PATH=./data/files
# Cookies браузера, где ты залогинен в Instagram / TikTok (Netscape cookies.txt):
# MEDIA_COOKIES_FILE=./data/media_cookies.txt
# MEDIA_COOKIES_FROM_BROWSER=chrome

# Full mode (Postgres + Redis + ARQ):
# CHRONICUM_LITE=false
# DATABASE_URL=postgresql+asyncpg://chronicum:chronicum@127.0.0.1:5432/chronicum
# REDIS_URL=redis://127.0.0.1:6379/0

AI_PROVIDER=groq
TRANSCRIBE_PROVIDER=groq
GROQ_LLM_MODEL=openai/gpt-oss-120b
WHISPER_LANGUAGE=auto
GROQ_WHISPER_MODEL=whisper-large-v3
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.0-flash

VIDEO_PREVIEW_THRESHOLD_MIN=10
VIDEO_FULL_SCORE_THRESHOLD=6
VIDEO_PREVIEW_FRACTION=0.2
# Parallel processing (lite in-process + ARQ video slots):
# JOB_CONCURRENCY — max materials of any type at once
# VIDEO_CONCURRENCY — max youtube/instagram/tiktok/video among those
JOB_CONCURRENCY=6
VIDEO_CONCURRENCY=3
ARQ_MAX_JOBS=4
MAX_API_RETRIES=3
LOG_LEVEL=INFO

WEB_API_TOKEN=chronicum-dev-token
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
WEB_ORIGIN=http://127.0.0.1:3000
# Lite local API is :8010 (avoids clash with other apps on :8000).
# scripts/load-env.ps1 forces this for web even if shell had :8000.
CHRONICUM_API_PORT=8010
NEXT_PUBLIC_API_URL=http://127.0.0.1:8010
# NEVER put WEB_API_TOKEN in NEXT_PUBLIC_* — it ships in the browser bundle.
NEXT_PUBLIC_ALLOW_DEV_TOKEN=0
ALLOW_PLACEHOLDER_SECRETS=true
# Admin WEB_API_TOKEN (sees all users) — off when Google OAuth is configured.
ALLOW_ADMIN_TOKEN=false

# Google Sign-In (OAuth 2.0 Web client in Google Cloud Console — free).
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8010/api/auth/google/callback
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_TTL_DAYS=30
